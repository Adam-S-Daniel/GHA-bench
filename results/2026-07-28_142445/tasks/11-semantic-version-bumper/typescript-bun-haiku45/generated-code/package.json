{
  "name": "semantic-version-bumper",
  "version": "1.0.0",
  "description": "Automated semantic version bumper for git repos",
  "type": "module",
  "main": "cli.ts",
  "scripts": {
    "start": "bun run cli.ts",
    "test": "bun test",
    "test:fixture": "bash test-fixtures.sh",
    "bump": "bun run cli.ts bump",
    "type-check": "bunx tsc --noEmit"
  },
  "keywords": [
    "semver",
    "versioning",
    "changelog",
    "git"
  ],
  "author": "Benchmark Suite",
