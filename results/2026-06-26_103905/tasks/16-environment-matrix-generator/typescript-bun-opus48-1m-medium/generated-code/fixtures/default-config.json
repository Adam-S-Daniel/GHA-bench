  "matrix": {
    "os": ["ubuntu-latest", "windows-latest"],
    "node": ["18", "20"]
  },
  "exclude": [
    { "os": "windows-latest", "node": "18" }
  ],
  "include": [
    { "os": "macos-latest", "node": "20", "experimental": true }
  ],
  "failFast": false,
  "maxParallel": 3,
  "maxSize": 50
}
