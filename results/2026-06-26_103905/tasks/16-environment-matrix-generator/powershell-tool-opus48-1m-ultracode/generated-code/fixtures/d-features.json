{
  "matrix": {
    "os": ["ubuntu-latest"],
    "python": ["3.11", "3.12"],
    "feature": ["legacy", "modern"]
  },
  "exclude": [
    { "python": "3.11", "feature": "legacy" }
  ],
  "include": [
    { "os": "ubuntu-latest", "python": "3.12", "feature": "modern", "experimental": true }
  ],
  "fail-fast": true
}
