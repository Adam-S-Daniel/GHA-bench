#requires -Version 7.0
Set-StrictMode -Version Latest

<#
.SYNOPSIS
    Generates a GitHub Actions strategy.matrix from a declarative config.

.DESCRIPTION
    This module turns a configuration object describing OS options, language
    versions and feature flags into a build matrix suitable for
    `strategy.matrix` in GitHub Actions. It mirrors the real GitHub Actions
    expansion semantics:

        1. Compute the cartesian product of every matrix dimension.
        2. Remove combinations matching any `exclude` entry.
        3. Apply `include` entries using GitHub's add-or-append rules.

    It also carries the strategy-level knobs (`fail-fast`, `max-parallel`) and
    validates that the expanded job count does not exceed a configurable
    maximum (GitHub's own hard limit is 256 jobs per matrix).

    The functions are deliberately small and individually testable; the public
    entry point is New-BuildMatrix.

.NOTES
    Config schema (mirrors GitHub Actions `strategy`):

        {
          "matrix": {                       # required
            "<dimension>": [ ...values ],   # one or more dimension arrays
            "include": [ { ... } ],         # optional, reserved key
            "exclude": [ { ... } ]          # optional, reserved key
          },
          "failFast":    true|false,        # optional, default true
          "maxParallel": <int>,             # optional, default null (unbounded)
          "maxSize":     <int>              # optional, default 256
        }
#>

# Keys inside `matrix` that are not build dimensions.
$script:ReservedMatrixKeys = @('include', 'exclude')

# GitHub Actions' own hard ceiling on jobs generated by a single matrix.
$script:DefaultMaxSize = 256

function Get-CartesianProduct {
    <#
    .SYNOPSIS
        Returns the cross product of the supplied matrix dimensions.
    .PARAMETER Dimensions
        An ordered hashtable mapping dimension name -> array of values.
    .OUTPUTS
        An array of ordered hashtables, one per combination. Each hashtable's
        keys follow the dimension declaration order so output is deterministic.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [System.Collections.IDictionary] $Dimensions
    )

    # Seed with a single empty combination so an empty dimension set still
    # yields exactly one (empty) job, matching GHA's include-only behaviour.
    $combos = [System.Collections.Generic.List[object]]::new()
    $combos.Add([ordered]@{})

    foreach ($key in $Dimensions.Keys) {
        $values = @($Dimensions[$key])
        if ($values.Count -eq 0) {
            # A dimension with no values collapses the whole product to nothing.
            return @()
        }

        $next = [System.Collections.Generic.List[object]]::new()
        foreach ($combo in $combos) {
            foreach ($value in $values) {
                $clone = [ordered]@{}
                foreach ($k in $combo.Keys) { $clone[$k] = $combo[$k] }
                $clone[$key] = $value
                $next.Add($clone)
            }
        }
        $combos = $next
    }

    # Unary comma prevents PowerShell from unwrapping a single-element array.
    return , $combos.ToArray()
}

function Test-CombinationMatchesFilter {
    <#
    .SYNOPSIS
        True when every key in $Filter is present in $Combination with an equal
        value. Keys absent from the combination never match (so a filter can
        never match a combination missing one of its keys).
    .PARAMETER OnlyKeys
        When supplied, only consider filter keys that appear in this list. Used
        by the include algorithm, which matches solely on original dimension
        keys and ignores the extra (added) keys an include carries.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)] [System.Collections.IDictionary] $Combination,
        [Parameter(Mandatory)] [System.Collections.IDictionary] $Filter,
        [string[]] $OnlyKeys
    )

    foreach ($key in $Filter.Keys) {
        if ($PSBoundParameters.ContainsKey('OnlyKeys') -and ($key -notin $OnlyKeys)) {
            continue
        }
        if (-not $Combination.Contains($key)) { return $false }
        if ([string]$Combination[$key] -ne [string]$Filter[$key]) { return $false }
    }
    return $true
}

function Remove-ExcludedCombinations {
    <#
    .SYNOPSIS
        Drops every combination matched by any exclude entry.
    .DESCRIPTION
        An exclude entry may name a subset of the dimensions; a combination is
        removed when it matches all key:value pairs of at least one entry.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)] [AllowEmptyCollection()] [object[]] $Combinations,
        [AllowEmptyCollection()] [object[]] $Excludes = @()
    )

    if (-not $Excludes -or $Excludes.Count -eq 0) { return $Combinations }

    $kept = [System.Collections.Generic.List[object]]::new()
    foreach ($combo in $Combinations) {
        $isExcluded = $false
        foreach ($ex in $Excludes) {
            if (Test-CombinationMatchesFilter -Combination $combo -Filter $ex) {
                $isExcluded = $true
                break
            }
        }
        if (-not $isExcluded) { $kept.Add($combo) }
    }
    return , $kept.ToArray()
}

function Add-IncludedCombinations {
    <#
    .SYNOPSIS
        Applies GitHub Actions `include` semantics to a set of combinations.
    .DESCRIPTION
        For each include entry, GitHub adds its key:value pairs to every
        ORIGINAL matrix combination whose dimension values it does not
        overwrite. Matching is done only on the original dimension keys; extra
        keys carried by the include are merged in (and may overwrite values
        added by earlier includes, but never original dimension values). If an
        include matches no original combination it is appended as a brand new
        standalone combination.
    .PARAMETER DimensionKeys
        The names of the original (cartesian) dimensions. Used to decide which
        include keys participate in matching.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)] [AllowEmptyCollection()] [object[]] $Combinations,
        [AllowEmptyCollection()] [object[]] $Includes = @(),
        [string[]] $DimensionKeys = @()
    )

    # Work on a mutable copy. Only indices [0, originalCount) are "original"
    # combinations eligible for include-merging; appended ones are not.
    $result = [System.Collections.Generic.List[object]]::new()
    foreach ($c in $Combinations) { $result.Add($c) }
    $originalCount = $result.Count

    if (-not $Includes) { return , $result.ToArray() }

    foreach ($inc in $Includes) {
        $matchedAny = $false
        for ($i = 0; $i -lt $originalCount; $i++) {
            $combo = $result[$i]
            if (Test-CombinationMatchesFilter -Combination $combo -Filter $inc -OnlyKeys $DimensionKeys) {
                # Merge all include keys into this combination. Original
                # dimension keys already equal the include value (that is why it
                # matched), so this only ever adds or overwrites extra keys.
                foreach ($k in $inc.Keys) { $combo[$k] = $inc[$k] }
                $matchedAny = $true
            }
        }

        if (-not $matchedAny) {
            $new = [ordered]@{}
            foreach ($k in $inc.Keys) { $new[$k] = $inc[$k] }
            $result.Add($new)
        }
    }

    return , $result.ToArray()
}

function ConvertFrom-MatrixConfigJson {
    <#
    .SYNOPSIS
        Parses a JSON config string into a config object, with a clear error.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)] [AllowEmptyString()] [string] $Json
    )

    try {
        return $Json | ConvertFrom-Json -ErrorAction Stop
    } catch {
        throw "Invalid configuration: could not parse JSON. $($_.Exception.Message)"
    }
}

function ConvertTo-OrderedDimensions {
    <#
    .SYNOPSIS
        Extracts the build dimensions from a parsed `matrix` object into an
        ordered hashtable, preserving declaration order and skipping the
        reserved include/exclude keys.
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory)] $Matrix)

    $dims = [ordered]@{}
    foreach ($prop in $Matrix.PSObject.Properties) {
        if ($prop.Name -in $script:ReservedMatrixKeys) { continue }
        $dims[$prop.Name] = @($prop.Value)
    }
    return $dims
}

function ConvertTo-OrderedHashtable {
    # Turns a PSCustomObject (e.g. an include/exclude entry from JSON) into an
    # ordered hashtable so the matching helpers can index it by key.
    param($Object)
    $ht = [ordered]@{}
    if ($null -eq $Object) { return $ht }
    if ($Object -is [System.Collections.IDictionary]) {
        foreach ($k in $Object.Keys) { $ht[$k] = $Object[$k] }
    } else {
        foreach ($prop in $Object.PSObject.Properties) { $ht[$prop.Name] = $prop.Value }
    }
    return $ht
}

function New-BuildMatrix {
    <#
    .SYNOPSIS
        Builds the full strategy matrix result from a config object.
    .OUTPUTS
        A PSCustomObject with: fail-fast, max-parallel, matrix (the raw
        dimensions + include/exclude as given), job-count and jobs (the fully
        expanded combination list used for size validation).
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)] $Config
    )

    if ($null -eq $Config) {
        throw 'Invalid configuration: config is null.'
    }
    if (-not $Config.PSObject.Properties.Match('matrix').Count -or $null -eq $Config.matrix) {
        throw "Invalid configuration: required 'matrix' section is missing."
    }

    $matrix = $Config.matrix
    $dimensions = ConvertTo-OrderedDimensions -Matrix $matrix
    $dimensionKeys = @($dimensions.Keys)

    # Pull reserved include/exclude lists out of the matrix object.
    $includesRaw = @()
    $excludesRaw = @()
    if ($matrix.PSObject.Properties.Match('include').Count -and $matrix.include) {
        $includesRaw = @($matrix.include)
    }
    if ($matrix.PSObject.Properties.Match('exclude').Count -and $matrix.exclude) {
        $excludesRaw = @($matrix.exclude)
    }

    if ($dimensionKeys.Count -eq 0 -and $includesRaw.Count -eq 0) {
        throw "Invalid configuration: 'matrix' must define at least one dimension or an include entry."
    }

    # Normalise include/exclude entries to ordered hashtables.
    $includes = @($includesRaw | ForEach-Object { ConvertTo-OrderedHashtable $_ })
    $excludes = @($excludesRaw | ForEach-Object { ConvertTo-OrderedHashtable $_ })

    # Expansion pipeline: product -> exclude -> include.
    $combos = Get-CartesianProduct -Dimensions $dimensions
    $combos = Remove-ExcludedCombinations -Combinations $combos -Excludes $excludes
    $combos = Add-IncludedCombinations -Combinations $combos -Includes $includes -DimensionKeys $dimensionKeys

    $jobCount = $combos.Count

    # Resolve strategy knobs with defaults.
    $failFast = $true
    if ($Config.PSObject.Properties.Match('failFast').Count -and $null -ne $Config.failFast) {
        $failFast = [bool]$Config.failFast
    }

    $maxParallel = $null
    if ($Config.PSObject.Properties.Match('maxParallel').Count -and $null -ne $Config.maxParallel) {
        $maxParallel = [int]$Config.maxParallel
        if ($maxParallel -lt 1) {
            throw "Invalid configuration: maxParallel must be a positive integer (got $maxParallel)."
        }
    }

    $maxSize = $script:DefaultMaxSize
    if ($Config.PSObject.Properties.Match('maxSize').Count -and $null -ne $Config.maxSize) {
        $maxSize = [int]$Config.maxSize
        if ($maxSize -lt 1) {
            throw "Invalid configuration: maxSize must be a positive integer (got $maxSize)."
        }
    }

    # The core validation requirement: never silently emit an oversized matrix.
    if ($jobCount -gt $maxSize) {
        throw "Generated matrix has $jobCount jobs which exceeds the maximum allowed size of $maxSize."
    }

    # Convert expanded combinations to plain objects for clean JSON output.
    $jobs = @($combos | ForEach-Object {
        $o = [ordered]@{}
        foreach ($k in $_.Keys) { $o[$k] = $_[$k] }
        [pscustomobject]$o
    })

    # Build the matrix section for output: dimensions in order, then the raw
    # include/exclude lists exactly as supplied (GHA accepts them verbatim).
    $matrixOut = [ordered]@{}
    foreach ($k in $dimensionKeys) { $matrixOut[$k] = $dimensions[$k] }
    if ($includesRaw.Count -gt 0) { $matrixOut['include'] = $includesRaw }
    if ($excludesRaw.Count -gt 0) { $matrixOut['exclude'] = $excludesRaw }

    return [pscustomobject][ordered]@{
        'fail-fast'    = $failFast
        'max-parallel' = $maxParallel
        'matrix'       = [pscustomobject]$matrixOut
        'job-count'    = $jobCount
        'jobs'         = $jobs
    }
}

function ConvertTo-MatrixJson {
    <#
    .SYNOPSIS
        Serialises a New-BuildMatrix result to JSON with sufficient depth.
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory, ValueFromPipeline)] $Matrix,
        [int] $Depth = 10
    )
    process {
        return $Matrix | ConvertTo-Json -Depth $Depth
    }
}

Export-ModuleMember -Function *

