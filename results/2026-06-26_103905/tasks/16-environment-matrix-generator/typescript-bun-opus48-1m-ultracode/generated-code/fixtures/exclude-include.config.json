{
  "fail-fast": false,
  "max-parallel": 4,
  "max-size": 100,
  "matrix": {
    "os": ["ubuntu-latest", "windows-latest"],
    "node": ["18", "20", "22"],
    "feature": ["minimal", "full"],
    "exclude": [
      { "os": "windows-latest", "node": "18" },
      { "feature": "full", "node": "18" }
    ],
    "include": [
      { "os": "macos-latest", "node": "22", "feature": "full", "experimental": true }
    ]
  }
}
