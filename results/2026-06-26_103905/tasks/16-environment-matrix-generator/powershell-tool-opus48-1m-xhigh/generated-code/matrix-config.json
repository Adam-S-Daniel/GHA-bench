{
  "matrix": {
    "os": ["ubuntu-latest", "macos-latest"],
    "python": ["3.11", "3.12"],
    "feature": ["minimal", "full"],
    "exclude": [
      { "os": "macos-latest", "feature": "full" }
    ],
    "include": [
      { "os": "ubuntu-latest", "python": "3.12", "feature": "full", "experimental": "true" }
    ]
  },
  "maxParallel": 4,
  "failFast": true,
  "maxSize": 100
}
