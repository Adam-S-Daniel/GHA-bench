{
  "fail-fast": false,
  "max-parallel": 2,
  "max-size": 50,
  "matrix": {
    "os": ["ubuntu-latest", "windows-latest"],
    "node": ["18", "20"],
    "experimental": [false],
    "exclude": [
      { "os": "windows-latest", "node": "18" }
    ],
    "include": [
      { "os": "ubuntu-latest", "node": "20", "coverage": true }
    ]
  }
}
