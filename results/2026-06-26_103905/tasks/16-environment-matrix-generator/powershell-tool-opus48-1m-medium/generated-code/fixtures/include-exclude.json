{
  "matrix": {
    "os": ["ubuntu-latest", "windows-latest", "macos-latest"],
    "node": ["18", "20"]
  },
  "exclude": [
    { "os": "windows-latest", "node": "18" }
  ],
  "include": [
    { "os": "ubuntu-latest", "node": "20", "coverage": true },
    { "os": "experimental-os", "node": "22" }
  ],
  "fail-fast": false,
  "max-parallel": 3,
  "max-size": 20
}
