{
  "matrix": {
    "os": ["ubuntu-latest", "windows-latest"],
    "version": ["20"],
    "feature": ["stable", "experimental"],
    "exclude": [
      {"os": "windows-latest", "feature": "experimental"}
    ],
    "include": [
      {"os": "ubuntu-latest", "version": "20", "feature": "experimental", "extra": "telemetry"}
    ]
  },
  "max-parallel": 5,
  "fail-fast": true,
  "max-size": 12
}
