{
  "matrix": {
    "os": ["ubuntu-latest", "windows-latest"],
    "version": ["18", "20", "22"],
    "exclude": [
      {"os": "windows-latest", "version": "18"}
    ],
    "include": [
      {"os": "ubuntu-latest", "version": "22", "coverage": "true"}
    ]
  },
  "max-parallel": 4,
  "fail-fast": false,
  "max-size": 25
}
