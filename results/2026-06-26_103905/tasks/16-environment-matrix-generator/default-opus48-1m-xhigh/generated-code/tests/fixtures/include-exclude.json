{
  "matrix": {
    "os": ["ubuntu-latest", "windows-latest", "macos-latest"],
    "version": ["3.11", "3.12"],
    "exclude": [
      {"os": "macos-latest", "version": "3.11"},
      {"os": "windows-latest", "version": "3.12"}
    ],
    "include": [
      {"os": "ubuntu-latest", "version": "3.11", "coverage": true},
      {"os": "ubuntu-latest", "version": "3.13", "experimental": true}
    ]
  },
  "max-parallel": 3,
  "fail-fast": true,
  "max-size": 50
}
