#!/usr/bin/env bats
#
# End-to-end integration tests that exercise the FULL GitHub Actions pipeline
# through `act` (nektos/act). Per the task requirements, every test case runs
# the real workflow in an isolated Docker container -- the script is never
# called directly here.
#
# For each case we:
#   1. build a throwaway git repo containing the project files + that case's
#      fixture data (VERSION + commits.txt),
#   2. run `act push --rm`,
#   3. append the full act output to ./act-result.txt (clearly delimited),
#   4. assert act exited 0, that BOTH jobs report "Job succeeded", and that the
#      output contains the EXACT expected version / bump type for that input.
#
# There are exactly three cases (minor / patch / major) => three `act push`
# runs, matching the run budget. Run with a generous timeout, e.g.:
#   bats test/integration_act.bats

setup_file() {
  local root
  root="$(cd "${BATS_TEST_DIRNAME}/.." && pwd)"
  # Start the required artifact fresh for this run.
  {
    echo "############################################################"
    echo "# act-result.txt - output of every workflow run via nektos/act"
    echo "# Generated by test/integration_act.bats"
    echo "############################################################"
    echo
  } > "${root}/act-result.txt"
}

setup() {
  ROOT="$(cd "${BATS_TEST_DIRNAME}/.." && pwd)"
  ACT_RESULT="${ROOT}/act-result.txt"
}

# _run_act_case NAME VERSION COMMITS EXPECTED_VERSION EXPECTED_BUMP
#   Build an isolated repo for the case, run the workflow via act, archive the
#   output, and assert on exact expected values.
_run_act_case() {
  local name="$1" version="$2" commits="$3" exp_version="$4" exp_bump="$5"

  local work
  work="$(mktemp -d)"

  # --- project files the workflow needs ---
  cp "${ROOT}/semantic-version-bumper.sh" "${work}/"
  cp "${ROOT}/.actrc" "${work}/"                       # pin the prebuilt act image
  mkdir -p "${work}/.github/workflows"
  cp "${ROOT}/.github/workflows/semantic-version-bumper.yml" \
     "${work}/.github/workflows/"

  # --- this case's fixture data ---
  printf '%s\n' "$version" > "${work}/VERSION"
  printf '%s\n' "$commits" > "${work}/commits.txt"

  # --- a real git repo on branch 'main' (checkout@v4 + push filter need it) ---
  git -C "$work" init -q
  git -C "$work" symbolic-ref HEAD refs/heads/main
  git -C "$work" config user.email ci@test.local
  git -C "$work" config user.name ci
  git -C "$work" add -A
  git -C "$work" commit -q -m "test: ${name} fixture"

  # --- run the pipeline through act ---
  # --pull=false: the runner image (act-ubuntu-pwsh:latest) is built locally
  # and is not in any registry, so act must NOT force-pull it.
  cd "$work"
  run act push --rm --pull=false
  cd "$ROOT"

  # --- archive output to the required artifact, clearly delimited ---
  {
    echo "==================== ACT CASE: ${name} ===================="
    echo "# input:    VERSION='${version}'  commits='${commits}'"
    echo "# expected: new_version=${exp_version}  bump_type=${exp_bump}"
    echo "# act exit status: ${status}"
    echo "--------------------------------------------------------------"
    echo "$output"
    echo "==================== END CASE: ${name} ===================="
    echo
  } >> "$ACT_RESULT"

  rm -rf "$work"

  # --- assertions ---
  # 1. act succeeded end-to-end.
  [ "$status" -eq 0 ]
  # 2. exact new version printed by the bump job.
  [[ "$output" == *"NEW_VERSION=${exp_version}"* ]]
  # 3. exact bump type printed by the bump job.
  [[ "$output" == *"Bump type: ${exp_bump}"* ]]
  # 4. the downstream report job received and printed the exact version
  #    (proves cross-job output passing works).
  [[ "$output" == *"RESULT_VERSION=${exp_version}"* ]]
  [[ "$output" == *"RESULT_BUMP=${exp_bump}"* ]]
  # 5. every job (bump + report) succeeded.
  local succeeded
  succeeded="$(printf '%s\n' "$output" | grep -c "Job succeeded")"
  [ "$succeeded" -ge 2 ]
}

@test "act/push: feat commit bumps 1.1.0 -> 1.2.0 (minor)" {
  _run_act_case "minor" "1.1.0" "feat: add a brand new feature" "1.2.0" "minor"
}

@test "act/push: fix commit bumps 2.3.4 -> 2.3.5 (patch)" {
  _run_act_case "patch" "2.3.4" "fix: resolve a defect" "2.3.5" "patch"
}

@test "act/push: breaking change bumps 1.4.2 -> 2.0.0 (major)" {
  _run_act_case "major" "1.4.2" "feat!: remove deprecated API" "2.0.0" "major"
}
