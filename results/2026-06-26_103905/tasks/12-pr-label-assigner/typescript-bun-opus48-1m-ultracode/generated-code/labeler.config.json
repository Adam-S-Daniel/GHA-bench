{
  "_comment": "Path-to-label rules for the PR label assigner. Each rule maps one label to one or more glob patterns. `priority` (default 0) orders the final label set and resolves conflicts inside a `group`. Rules without a `group` are additive, so a file can collect several labels.",
  "rules": [
    { "label": "documentation", "patterns": ["docs/**", "*.md"], "priority": 1 },
    { "label": "api", "patterns": ["src/api/**"], "priority": 30 },
    { "label": "frontend", "patterns": ["src/web/**", "*.css", "*.tsx"], "priority": 20 },
    { "label": "tests", "patterns": ["*.test.*", "tests/**", "**/__tests__/**"], "priority": 10 },
    { "label": "ci", "patterns": [".github/**", "*.yml", "*.yaml"], "priority": 5 },
    { "label": "dependencies", "patterns": ["package.json", "bun.lockb", "**/package.json"], "priority": 5 },

    { "label": "area/api", "patterns": ["src/api/**"], "group": "area", "priority": 100 },
    { "label": "area/frontend", "patterns": ["src/web/**"], "group": "area", "priority": 50 },
    { "label": "area/other", "patterns": ["**"], "group": "area", "priority": 1 }
  ]
}
