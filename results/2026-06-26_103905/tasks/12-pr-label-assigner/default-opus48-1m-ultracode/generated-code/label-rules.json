{
  "rules": [
    {"pattern": "docs/**",          "labels": ["documentation"],  "priority": 10, "group": "doc-area"},
    {"pattern": "docs/internal/**", "labels": ["internal-docs"],  "priority": 20, "group": "doc-area"},
    {"pattern": "src/api/**",       "labels": ["api", "backend"], "priority": 40},
    {"pattern": "src/web/**",       "labels": ["frontend"],       "priority": 30},
    {"pattern": "*.test.*",         "labels": ["tests"],          "priority": 50},
    {"pattern": ".github/**",       "labels": ["ci"],             "priority": 25}
  ]
}
