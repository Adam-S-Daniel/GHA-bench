{
  "rules": [
    { "pattern": "docs/**",       "labels": ["documentation"],   "priority": 10 },
    { "pattern": "*.md",          "labels": ["documentation"],   "priority": 10 },
    { "pattern": "src/**",        "labels": ["backend"],         "priority": 20 },
    { "pattern": "package.json",  "labels": ["dependencies"],    "priority": 25 },
    { "pattern": "src/api/**",    "labels": ["api", "backend"],  "priority": 30 },
    { "pattern": "**/*.test.*",   "labels": ["tests"],           "priority": 40 },
    { "pattern": "generated/**",  "labels": ["skip-review"],     "priority": 99, "exclusive": true }
  ]
}
