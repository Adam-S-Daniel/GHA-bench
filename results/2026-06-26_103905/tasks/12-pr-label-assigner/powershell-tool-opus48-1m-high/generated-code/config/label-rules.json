{
  "rules": [
    { "pattern": "src/api/**", "labels": ["api", "backend"], "priority": 40 },
    { "pattern": "src/web/**", "labels": ["frontend"],       "priority": 35 },
    { "pattern": "*.test.*",   "labels": ["tests"],          "priority": 30 },
    { "pattern": "*.spec.*",   "labels": ["tests"],          "priority": 30 },
    { "pattern": "docs/**",    "labels": ["documentation"],  "priority": 20 },
    { "pattern": "**/*.md",    "labels": ["documentation"],  "priority": 20 },
    { "pattern": ".github/**", "labels": ["ci"],             "priority": 25 },
    { "pattern": "src/**",     "labels": ["source"],         "priority": 10 }
  ]
}
