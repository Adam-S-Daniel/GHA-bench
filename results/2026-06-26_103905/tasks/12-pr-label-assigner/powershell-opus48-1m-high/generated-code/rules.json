{
  "rules": [
    { "pattern": "docs/**",          "labels": ["documentation"],   "priority": 10 },
    { "pattern": "*.md",             "labels": ["documentation"],   "priority": 10 },
    { "pattern": "src/api/**",       "labels": ["api", "backend"],  "priority": 40, "exclusiveGroup": "area" },
    { "pattern": "src/web/**",       "labels": ["frontend"],        "priority": 35, "exclusiveGroup": "area" },
    { "pattern": "src/**",           "labels": ["backend"],         "priority": 20, "exclusiveGroup": "area" },
    { "pattern": "*.test.*",         "labels": ["tests"],           "priority": 50 },
    { "pattern": "**/*.spec.*",      "labels": ["tests"],           "priority": 50 },
    { "pattern": ".github/**",       "labels": ["ci"],              "priority": 30 }
  ]
}
