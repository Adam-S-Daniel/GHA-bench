{
  "//": "Configurable path-to-label rules. Higher priority wins ordering; a rule with stopOnMatch:true is exclusive (suppresses lower-priority rules for a matching file).",
  "rules": [
    { "pattern": "**/*.generated.*", "labels": ["generated"],        "priority": 100, "stopOnMatch": true },
    { "pattern": "*.test.*",         "labels": ["tests"],            "priority": 50 },
    { "pattern": "package.json",     "labels": ["dependencies"],     "priority": 40 },
    { "pattern": "src/api/**",       "labels": ["api", "backend"],   "priority": 30 },
    { "pattern": "src/**",           "labels": ["source"],           "priority": 20 },
    { "pattern": "docs/**",          "labels": ["documentation"],    "priority": 10 },
    { "pattern": "*.md",             "labels": ["documentation"],    "priority": 10 }
  ]
}
