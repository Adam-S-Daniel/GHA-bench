{
  "$comment": "Path-glob -> label rules. Higher priority surfaces first in the final, de-duplicated label set. A file may match several rules and gain several labels.",
  "rules": [
    { "pattern": "src/api/**",     "labels": ["api", "backend"], "priority": 50 },
    { "pattern": "**/*.test.*",    "labels": ["tests"],          "priority": 40 },
    { "pattern": "**/*.Tests.ps1", "labels": ["tests"],          "priority": 40 },
    { "pattern": ".github/**",     "labels": ["ci"],             "priority": 30 },
    { "pattern": "src/**",         "labels": ["source"],         "priority": 20 },
    { "pattern": "docs/**",        "labels": ["documentation"],  "priority": 10 },
    { "pattern": "**/*.md",        "labels": ["documentation"],  "priority": 10 },
    { "pattern": "*.json",         "labels": ["config"],         "priority": 5 }
  ]
}
