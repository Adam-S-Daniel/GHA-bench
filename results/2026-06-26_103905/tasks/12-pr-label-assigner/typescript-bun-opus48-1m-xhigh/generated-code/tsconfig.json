{
  "compilerOptions": {
    // Target a modern runtime — Bun supports the latest ECMAScript features.
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Pull in Bun's ambient type definitions so `Bun`, `import.meta.main`, etc. type-check.
    "types": ["bun"],

    // Strictness: catch as many bugs as possible at type-check time.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
