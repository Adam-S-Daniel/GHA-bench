{
  "os": ["ubuntu-latest", "macos-latest", "windows-latest"],
  "node": ["16", "18", "20"],
  "include": [
    {
      "os": "ubuntu-latest",
      "node": "21",
      "experimental": true
    }
  ],
  "exclude": [
    {
      "os": "windows-latest",
      "node": "16"
    }
  ],
  "max-parallel": 6,
  "fail-fast": false,
  "maxSize": 15
}
