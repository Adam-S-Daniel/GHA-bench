#!/usr/bin/env bats
# Verifies the artifact produced by running the workflow through `act`
# (see act-result.txt, generated by `act push --rm --pull=false`).

setup() {
  RESULT="$BATS_TEST_DIRNAME/../act-result.txt"
}

@test "act-result.txt exists" {
  [ -f "$RESULT" ]
}

@test "act-result.txt shows both jobs succeeded" {
  count=$(grep -c "🏁  Job succeeded" "$RESULT")
  [ "$count" -eq 2 ]
}

@test "act-result.txt contains the exact expected computed labels" {
  run grep -F 'Computed labels: ["documentation","api","tests","source"]' "$RESULT"
  [ "$status" -eq 0 ]
}

@test "act-result.txt records a passing assertion" {
  run grep -F "PASS: exact label output matched" "$RESULT"
  [ "$status" -eq 0 ]
}

@test "act-result.txt shows the bats suite passed inside the container" {
  run grep -F "ok 12 supports json output format" "$RESULT"
  [ "$status" -eq 0 ]
}
