{
  "rules": [
    {"pattern": "docs/**", "label": "documentation", "priority": 1},
    {"pattern": "src/api/**", "label": "api", "priority": 5},
    {"pattern": "*.test.*", "label": "tests", "priority": 1},
    {"pattern": "src/**", "label": "size/large", "priority": 1, "group": "size"},
    {"pattern": "src/api/**", "label": "size/small", "priority": 10, "group": "size"}
  ]
}
