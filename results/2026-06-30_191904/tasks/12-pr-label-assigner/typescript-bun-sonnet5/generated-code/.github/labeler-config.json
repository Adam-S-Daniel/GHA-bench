{
  "rules": [
    { "pattern": "src/api/**", "label": "api", "priority": 10 },
    { "pattern": "package.json", "label": "dependencies", "priority": 8 },
    { "pattern": "bun.lock", "label": "dependencies", "priority": 8 },
    { "pattern": ".github/**", "label": "ci", "priority": 7 },
    { "pattern": "*.test.*", "label": "tests", "priority": 5 },
    { "pattern": "docs/**", "label": "documentation", "priority": 1 },
    { "pattern": "*.md", "label": "documentation", "priority": 1 },
    { "pattern": "**/*.ts", "label": "code", "priority": 0 }
  ]
}
