{
  "dimensions": {
    "os": ["ubuntu-latest", "windows-latest", "macos-latest"],
    "python-version": ["3.9", "3.10"]
  },
  "exclude": [
    { "os": "macos-latest", "python-version": "3.9" }
  ],
  "include": [
    { "os": "ubuntu-latest", "python-version": "3.9", "experimental": true }
  ],
  "fail_fast": false,
  "max_parallel": 3,
  "max_size": 20
}
