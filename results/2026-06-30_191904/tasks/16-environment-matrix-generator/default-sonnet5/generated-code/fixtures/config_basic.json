{
  "dimensions": {
    "os": ["ubuntu-latest", "windows-latest"],
    "python_version": ["3.10", "3.11"]
  },
  "include": [
    {"os": "ubuntu-latest", "python_version": "3.12", "experimental": true}
  ],
  "exclude": [
    {"os": "windows-latest", "python_version": "3.10"}
  ],
  "fail_fast": false,
  "max_parallel": 4,
  "max_size": 10
}
