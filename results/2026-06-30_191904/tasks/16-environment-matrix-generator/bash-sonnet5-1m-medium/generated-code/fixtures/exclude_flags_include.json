{
  "os": ["ubuntu-latest", "windows-latest", "macos-latest"],
  "versions": ["18", "20"],
  "flags": { "arch": ["x64", "arm64"] },
  "exclude": [
    { "os": "macos-latest", "arch": "x64" },
    { "os": "windows-latest", "version": "18" }
  ],
  "include": [
    { "os": "ubuntu-latest", "version": "22", "arch": "x64", "experimental": true },
    { "os": "ubuntu-latest", "version": "18", "arch": "x64", "canary": true }
  ],
  "fail-fast": false,
  "max-size": 30
}
