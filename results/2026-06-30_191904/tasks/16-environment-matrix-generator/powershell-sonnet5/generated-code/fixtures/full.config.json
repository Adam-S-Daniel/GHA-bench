{
  "matrix": {
    "os": ["ubuntu-latest", "windows-latest"],
    "node": [16, 18]
  },
  "exclude": [
    { "os": "windows-latest", "node": 16 }
  ],
  "include": [
    { "os": "ubuntu-latest", "node": 18, "experimental": true },
    { "os": "macos-latest", "node": 20 }
  ],
  "fail-fast": false,
  "max-parallel": 3,
  "max-size": 10
}
