{
  "matrix": {
    "os": ["ubuntu-latest", "windows-latest"],
    "version": ["18", "20"]
  },
  "include": [
    { "os": "macos-latest", "version": "20", "experimental": true }
  ],
  "exclude": [
    { "os": "windows-latest", "version": "18" }
  ],
  "maxParallel": 4,
  "failFast": false,
  "maxSize": 256
}
