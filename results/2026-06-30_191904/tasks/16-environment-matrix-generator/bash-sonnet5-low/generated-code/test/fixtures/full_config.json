{
  "os": ["ubuntu-latest", "windows-latest", "macos-latest"],
  "versions": ["16", "18", "20"],
  "flags": {
    "experimental": [true, false]
  },
  "include": [
    { "os": "ubuntu-latest", "versions": "21", "experimental": true }
  ],
  "exclude": [
    { "os": "windows-latest", "versions": "16" },
    { "os": "macos-latest", "experimental": true }
  ],
  "max_parallel": 4,
  "fail_fast": false,
  "max_size": 256
}
