#!/usr/bin/env bats
# Structural tests for the GitHub Actions workflow, and assertions on the
# captured `act push` output in act-result.txt (generated by run-act-tests.sh).
# These tests do NOT re-invoke act; they verify the artifact it already produced.

setup() {
  ROOT="${BATS_TEST_DIRNAME}/.."
  WORKFLOW="${ROOT}/.github/workflows/secret-rotation-validator.yml"
  RESULT="${ROOT}/act-result.txt"
}

@test "workflow file exists" {
  [ -f "$WORKFLOW" ]
}

@test "workflow is valid YAML" {
  run python3 -c "import yaml,sys; yaml.safe_load(open(sys.argv[1]))" "$WORKFLOW"
  [ "$status" -eq 0 ]
}

@test "actionlint passes on the workflow" {
  run actionlint "$WORKFLOW"
  [ "$status" -eq 0 ]
  [ -z "$output" ]
}

@test "workflow declares push, pull_request, workflow_dispatch, and schedule triggers" {
  run python3 -c "
import yaml, sys
doc = yaml.safe_load(open(sys.argv[1]))
# PyYAML parses the bare 'on:' key as boolean True (YAML 1.1); handle both.
triggers = doc.get('on', doc.get(True))
for name in ('push', 'pull_request', 'workflow_dispatch', 'schedule'):
    assert name in triggers, f'missing trigger: {name}'
print('all triggers present')
" "$WORKFLOW"
  [ "$status" -eq 0 ]
  [[ "$output" == *"all triggers present"* ]]
}

@test "workflow references scripts and fixtures that exist in the repo" {
  run grep -o 'scripts/secret-rotation-validator\.sh' "$WORKFLOW"
  [ "$status" -eq 0 ]
  [ -f "${ROOT}/scripts/secret-rotation-validator.sh" ]

  run grep -o 'fixtures/secrets_basic\.json' "$WORKFLOW"
  [ "$status" -eq 0 ]
  [ -f "${ROOT}/fixtures/secrets_basic.json" ]

  run grep -o 'tests/rotation\.bats' "$WORKFLOW"
  [ "$status" -eq 0 ]
  [ -f "${ROOT}/tests/rotation.bats" ]
}

@test "workflow sets read-only top-level permissions" {
  run python3 -c "
import yaml, sys
doc = yaml.safe_load(open(sys.argv[1]))
assert doc['permissions']['contents'] == 'read'
print('read')
" "$WORKFLOW"
  [ "$status" -eq 0 ]
  [[ "$output" == *"read"* ]]
}

@test "act-result.txt artifact exists" {
  [ -f "$RESULT" ]
}

@test "act-result.txt records ACT_EXIT_CODE=0 for the test case" {
  run grep -c "^ACT_EXIT_CODE=0$" "$RESULT"
  [ "$status" -eq 0 ]
  [ "$output" -ge 1 ]
}

@test "act-result.txt shows the job succeeded" {
  run grep -c "Job succeeded" "$RESULT"
  [ "$status" -eq 0 ]
  [ "$output" -ge 1 ]
}

@test "act-result.txt contains the exact expected JSON report" {
  run grep -F '{"today":"2026-07-01","warning_days":14,"secrets":[{"name":"db-password","last_rotated":"2026-01-01","rotation_days":90,"required_by":["api","worker"],"status":"expired","days_left":-91},{"name":"api-key","last_rotated":"2026-06-20","rotation_days":30,"required_by":["frontend"],"status":"ok","days_left":19},{"name":"tls-cert","last_rotated":"2026-06-01","rotation_days":365,"required_by":["gateway"],"status":"ok","days_left":335}],"summary":{"expired":1,"warning":0,"ok":2}}' "$RESULT"
  [ "$status" -eq 0 ]
}

@test "act-result.txt contains the exact expected markdown row for the expired secret" {
  run grep -F '| db-password | expired | -91 | api, worker |' "$RESULT"
  [ "$status" -eq 0 ]
}

@test "act-result.txt contains the exact expected markdown rows for the ok secrets" {
  run grep -F '| api-key | ok | 19 | frontend |' "$RESULT"
  [ "$status" -eq 0 ]
  run grep -F '| tls-cert | ok | 335 | gateway |' "$RESULT"
  [ "$status" -eq 0 ]
}

@test "act-result.txt shows all 16 bats unit tests passed inside the container" {
  run grep -c "^\[Secret Rotation Validator/Lint, test, and run the rotation validator\]   | ok " "$RESULT"
  [ "$status" -eq 0 ]
  [ "$output" -eq 16 ]
}
