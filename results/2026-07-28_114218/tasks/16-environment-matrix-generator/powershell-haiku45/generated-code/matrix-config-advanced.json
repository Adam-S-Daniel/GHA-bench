{
  "os": ["ubuntu-latest", "windows-latest", "macos-latest"],
  "version": ["16", "18", "20"],
  "features": ["minimal", "standard"],
  "include": [
    {
      "os": "ubuntu-latest",
      "version": "18",
      "features": "extended",
      "experimental": true
    }
  ],
  "exclude": [
    {
      "os": "windows-latest",
      "version": "16"
    },
    {
      "os": "macos-latest",
      "features": "minimal"
    }
  ],
  "maxParallel": 4,
  "failFast": true,
  "maxSize": 256
}
