{
  "os": ["ubuntu-latest", "macos-latest", "windows-latest"],
  "languages": ["python", "node", "ruby"],
  "features": ["debug", "release"],
  "nodeVersions": ["18", "20"],
  "exclude": [
    {
      "os": "windows-latest",
      "language": "ruby"
    },
    {
      "language": "ruby",
      "feature": "debug"
    }
  ],
  "include": [
    {
      "os": "custom-runner",
      "language": "go",
      "arch": "arm64"
    }
  ],
  "maxParallel": 5,
  "failFast": false,
  "maxSize": 500
}
