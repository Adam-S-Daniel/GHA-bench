{
  "matrix": {
    "os": ["ubuntu-latest", "macos-latest"],
    "node": ["18", "20"],
    "feature-flag": ["stable", "beta"],
    "exclude": [
      { "os": "macos-latest", "node": "18" },
      { "os": "macos-latest", "feature-flag": "beta" }
    ],
    "include": [
      { "os": "ubuntu-latest", "node": "20", "coverage": true },
      { "os": "windows-latest", "node": "22", "feature-flag": "stable" }
    ]
  },
  "fail-fast": true,
  "max-parallel": 2,
  "max-size": 16
}
