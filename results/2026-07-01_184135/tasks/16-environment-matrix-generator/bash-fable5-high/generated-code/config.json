{
  "os": ["ubuntu-latest", "macos-latest"],
  "language-versions": ["3.11", "3.12"],
  "feature-flags": ["standard"],
  "include": [
    { "os": "ubuntu-latest", "language-version": "3.13", "feature-flag": "experimental" }
  ],
  "exclude": [
    { "os": "macos-latest", "language-version": "3.11" }
  ],
  "max-parallel": 3,
  "fail-fast": false,
  "max-size": 50
}
