{
  "os": ["ubuntu-latest", "macos-latest"],
  "language-versions": ["3.11", "3.12"],
  "feature-flags": ["standard", "experimental"],
  "include": [
    { "os": "ubuntu-latest", "language-version": "3.13", "feature-flag": "standard" }
  ],
  "exclude": [
    { "os": "macos-latest", "feature-flag": "experimental" }
  ],
  "max-parallel": 4,
  "fail-fast": false
}
