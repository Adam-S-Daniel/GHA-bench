# Benchmark workspaces (large, temporary)
workspaces/2026-*

# Local benchmark run logs
logs/

# Single-instance lock files (runner.py / supervisor)
.runner.lock
.supervisor.lock

# Python
__pycache__/

# .NET/c#
**/bin/
**/obj/

# Note: /.github/workflows/ci.yml is the repo's own CI.
# Agent-generated workflows only exist inside workspaces/.

# Claude Code local state. NOT a blanket `/.claude/` ignore: the fleet's
# skills-bootstrap delivery commits `.claude/hooks/skills-bootstrap.sh` and
# `.claude/settings.json` here, and `git add` on an ignored path exits 1 —
# which under `set -euo pipefail` aborts the whole two-owner sync run at this
# repo and silently leaves every repo after it unsynced. So the ignore names
# the transient files instead of the directory.
/.claude/settings.local.json
/.claude/worktrees/
/.claude/scheduled_tasks.lock
/.claude/skills/
.cache/
